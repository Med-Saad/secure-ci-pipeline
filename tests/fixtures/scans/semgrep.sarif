{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "javascript.express.security.audit.xss.direct-response-write",
              "defaultConfiguration": { "level": "error" },
              "properties": { "security-severity": "8.6" }
            },
            {
              "id": "javascript.lang.best-practice.leftover-debugging",
              "defaultConfiguration": { "level": "warning" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.express.security.audit.xss.direct-response-write",
          "level": "error",
          "message": { "text": "Detected directly writing user input to the response (XSS)." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/controllers/api.js" },
                "region": { "startLine": 142 }
              }
            }
          ]
        },
        {
          "ruleId": "javascript.lang.best-practice.leftover-debugging",
          "message": { "text": "Leftover console.log call." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "src/util/logger.js" },
                "region": { "startLine": 7 }
              }
            }
          ]
        }
      ]
    }
  ]
}
